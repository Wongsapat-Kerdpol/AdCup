# Copy this file to `.env` and adjust. Never commit `.env`.

# --- PostgreSQL ---
POSTGRES_USER=adcup
POSTGRES_PASSWORD=adcup_dev_password
POSTGRES_DB=adcup

# --- Backend (FastAPI) ---
# Inside docker compose the DB host is `db`. If you run the backend directly
# on your machine, use localhost instead.
DATABASE_URL=postgresql+psycopg://adcup:adcup_dev_password@db:5432/adcup
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# HMAC key for identity signals (linked account detection). Changing it orphans every stored signal.
IDENTITY_HASH_SECRET=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:3000
# Enables POST /api/auth/dev-login (one-click login as seeded users). Turn off in production.
DEV_LOGIN_ENABLED=true
# Seeds demo users + campaigns on startup when the DB is empty.
SEED_ON_STARTUP=true

# --- Google OAuth / YouTube (Person 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
# API key (Google Cloud -> Credentials -> API key, restricted to YouTube Data API v3)
YOUTUBE_API_KEY=

# --- Duplicate-clip checker (dHash + BK-Tree warnings on the admin review queue) ---
ENABLE_ANTI_FRAUD=true

# --- TikTok Login Kit (Person 3) — developers.tiktok.com, Sandbox, scopes user.info.basic + video.list ---
# The redirect URI must be https (use an ngrok domain pointed at the backend, port 8000).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.ngrok-free.app/api/tiktok/callback

# --- Frontend (Next.js) ---
# URL the *browser* uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
